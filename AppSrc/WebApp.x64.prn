37272>>>    Procedure DoLogin
37275>>>        String sLoginName sPassword sPrevStateHash
37275>>>        Boolean bResult
37275>>>        
37275>>>        WebGet psValue of oLoginName to sLoginName
37276>>>        WebGet psValue of oPassword to sPassword
37277>>>        
37277>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37278>>>        
37278>>>        If (bResult) Begin
37280>>>            Send Hide of oLogin
37281>>>            Send ShowHeader of ghoWebApp
37282>>>            WebSet psCSSClass of ghoWebApp to ""
37283>>>            
37283>>>            WebGet psPrevStateHash to sPrevStateHash
37284>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37285>>>            
37285>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37285>>>            WebSet psValue of oLoginName to ""
37286>>>            WebSet psValue of oPassword  to ""
37287>>>            WebSet pbVisible of oWarning to False
37288>>>        End
37288>>>>
37288>>>        Else Begin
37289>>>            WebSet pbVisible of oWarning to True
37290>>>        End
37290>>>>
37290>>>    End_Procedure
37291>>>    
37291>>>    Procedure OnSubmit
37294>>>        Send DoLogin
37295>>>    End_Procedure
