38256>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38259>>>        Case Begin
38259>>>            Case (NavigateData.eNavigateType = nfFromMain)
38261>>>                // If from main, this is a propbably a main file Select to Zoom.
38261>>>                Case Break
38262>>>
38262>>>            Case (NavigateData.eNavigateType = nfFromParent)
38265>>>                // If from parent, this is a constrained drill down.
38265>>>                Case Break
38266>>>
38266>>>            Case (NavigateData.eNavigateType = nfFromChild)
38269>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38269>>>                Case Break
38270>>>
38270>>>            Case Else // must be nfUndefined
38270>>>
38270>>>        Case End
38270>>>
38270>>>        Send SetActionButtons
38271>>>
38271>>>    End_Procedure
