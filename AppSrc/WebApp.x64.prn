37667>>>    Procedure SetActionButtons
37670>>>        tWebNavigateData NavigateData
37670>>>        tWebNavigateData NavigateData
37670>>>        Boolean bHasRecord
37670>>>        Handle hoDD
37670>>>
37670>>>        Get Server to hoDD
37671>>>        Get GetNavigateData to NavigateData
37672>>>        Get HasRecord of hoDD to bHasRecord
37673>>>
37673>>>        // let's hide all buttons and then Show the ones we want
