37913>>>    Procedure SetActionButtons
37916>>>        tWebNavigateData NavigateData
37916>>>        tWebNavigateData NavigateData
37916>>>        Boolean bHasRecord
37916>>>        Handle hoDD
37916>>>
37916>>>        Get Server to hoDD
37917>>>        Get GetNavigateData to NavigateData
37918>>>        Get HasRecord of hoDD to bHasRecord
37919>>>
37919>>>        // let's hide all buttons and then Show the ones we want
37919>>>        WebSet pbRender of oEditBtn to False
37920>>>        WebSet pbRender of oSaveBtn to False
37921>>>        WebSet pbRender of oCancelChangesBtn to False
37922>>>        WebSet pbRender of oDeleteBtn to False
37923>>>
37923>>>        If (NavigateData.bReadOnly) Begin
37925>>>            WebSet pbRender of oEditBtn to True
37926>>>        End
37926>>>>
37926>>>        Else Begin
37927>>>            WebSet pbRender of oSaveBtn to True
37928>>>            WebSet pbRender of oCancelChangesBtn to True
37929>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37930>>>        End
37930>>>>
37930>>>    End_Procedure
