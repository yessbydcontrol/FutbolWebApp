38279>>>    Procedure SetActionButtons
38282>>>        tWebNavigateData NavigateData
38282>>>        tWebNavigateData NavigateData
38282>>>        Boolean bHasRecord
38282>>>        Handle hoDD
38282>>>
38282>>>        Get Server to hoDD
38283>>>        Get GetNavigateData to NavigateData
38284>>>        Get HasRecord of hoDD to bHasRecord
38285>>>
38285>>>        // let's hide all buttons and then Show the ones we want
38285>>>        WebSet pbRender of oEditBtn to False
38286>>>        WebSet pbRender of oSaveBtn to False
38287>>>        WebSet pbRender of oCancelChangesBtn to False
38288>>>        WebSet pbRender of oDeleteBtn to False
38289>>>
38289>>>        If (NavigateData.bReadOnly) Begin
38291>>>            WebSet pbRender of oEditBtn to True
38292>>>        End
38292>>>>
38292>>>        Else Begin
38293>>>            WebSet pbRender of oSaveBtn to True
38294>>>            WebSet pbRender of oCancelChangesBtn to True
38295>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38296>>>        End
38296>>>>
38296>>>    End_Procedure
38297>>>
38297>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38300>>>        // Close after save
38300>>>        Send NavigateClose Self
38301>>>    End_Procedure
38302>>>
38302>>>    // this will close the view after a delete
38302>>>    Procedure OnViewDeleted Handle hoDDO
38305>>>        Send NavigateClose Self
38306>>>    End_Procedure
38307>>>
38307>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38310>>>        Case Begin
38310>>>            Case (NavigateData.eNavigateType = nfFromMain)
38312>>>                // If from main, this is a propbably a main file Select to Zoom.
38312>>>                Case Break
38313>>>
38313>>>            Case (NavigateData.eNavigateType = nfFromParent)
38316>>>                // If from parent, this is a constrained drill down.
38316>>>                Case Break
38317>>>
38317>>>            Case (NavigateData.eNavigateType = nfFromChild)
38320>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38320>>>                Case Break
38321>>>
38321>>>            Case Else // must be nfUndefined
38321>>>
38321>>>        Case End
38321>>>
38321>>>        Send SetActionButtons
38322>>>
38322>>>    End_Procedure
38323>>>
38323>>>End_Object 
