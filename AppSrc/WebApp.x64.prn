38334>>>    Procedure SetActionButtons
38337>>>        tWebNavigateData NavigateData
38337>>>        tWebNavigateData NavigateData
38337>>>        Boolean bHasRecord
38337>>>        Handle hoDD
38337>>>
38337>>>        Get Server to hoDD
38338>>>        Get GetNavigateData to NavigateData
38339>>>        Get HasRecord of hoDD to bHasRecord
38340>>>
38340>>>        // let's hide all buttons and then Show the ones we want
38340>>>        WebSet pbRender of oEditBtn to False
38341>>>        WebSet pbRender of oSaveBtn to False
38342>>>        WebSet pbRender of oCancelChangesBtn to False
38343>>>        WebSet pbRender of oDeleteBtn to False
38344>>>
38344>>>        If (NavigateData.bReadOnly) Begin
38346>>>            WebSet pbRender of oEditBtn to True
38347>>>        End
38347>>>>
38347>>>        Else Begin
38348>>>            WebSet pbRender of oSaveBtn to True
38349>>>            WebSet pbRender of oCancelChangesBtn to True
38350>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38351>>>        End
38351>>>>
38351>>>    End_Procedure
38352>>>
38352>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38355>>>        // Close after save
38355>>>        Send NavigateClose Self
38356>>>    End_Procedure
38357>>>
38357>>>    // this will close the view after a delete
38357>>>    Procedure OnViewDeleted Handle hoDDO
38360>>>        Send NavigateClose Self
38361>>>    End_Procedure
38362>>>
38362>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38365>>>        Case Begin
38365>>>            Case (NavigateData.eNavigateType = nfFromMain)
38367>>>                // If from main, this is a propbably a main file Select to Zoom.
38367>>>                Case Break
38368>>>
38368>>>            Case (NavigateData.eNavigateType = nfFromParent)
38371>>>                // If from parent, this is a constrained drill down.
38371>>>                Case Break
38372>>>
38372>>>            Case (NavigateData.eNavigateType = nfFromChild)
38375>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38375>>>                Case Break
38376>>>
38376>>>            Case Else // must be nfUndefined
38376>>>
38376>>>        Case End
38376>>>
38376>>>        Send SetActionButtons
38377>>>
38377>>>    End_Procedure
38378>>>
38378>>>End_Object 
