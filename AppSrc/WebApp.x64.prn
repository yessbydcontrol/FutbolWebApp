37768>>>
37768>>>            Case Else // must be nfUndefined
37768>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37768>>>                // If Row select does main-zoom we don't need this
37768>>>                WebSet pbRender of oDetailButton to False
37769>>>
37769>>>        Case End
