38228>>>    Procedure SetActionButtons
38231>>>        tWebNavigateData NavigateData
38231>>>        tWebNavigateData NavigateData
38231>>>        Boolean bHasRecord
38231>>>        Handle hoDD
38231>>>
38231>>>        Get Server to hoDD
38232>>>        Get GetNavigateData to NavigateData
38233>>>        Get HasRecord of hoDD to bHasRecord
38234>>>
38234>>>        // let's hide all buttons and then Show the ones we want
38234>>>        WebSet pbRender of oEditBtn to False
38235>>>        WebSet pbRender of oSaveBtn to False
38236>>>        WebSet pbRender of oCancelChangesBtn to False
38237>>>        WebSet pbRender of oDeleteBtn to False
38238>>>
38238>>>        If (NavigateData.bReadOnly) Begin
38240>>>            WebSet pbRender of oEditBtn to True
38241>>>        End
38241>>>>
38241>>>        Else Begin
38242>>>            WebSet pbRender of oSaveBtn to True
38243>>>            WebSet pbRender of oCancelChangesBtn to True
38244>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38245>>>        End
38245>>>>
38245>>>    End_Procedure
