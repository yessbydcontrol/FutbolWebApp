Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1024
    Set psCaption to "Inicio"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 16
            Set piColumnIndex to 4
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            Object oFilaSuperior is a cWebGroup
                Set piColumnSpan to 12
                Set piColumnCount to 12
                Set pbShowBorder to False
                Set pbShowCaption to False

                Object oEntrenadorTile is a cWebHtmlBox
                    Set pbServerOnClick to True
                    Set piColumnSpan to 4
                    Set piColumnIndex to 2
                    Set psCSSClass to "Tile LightAlternate"
                    Set psHtml to '<div class="TileInner" data-ServerOnClick="openview"><div class="Tile_Title">👔 Entrenadores</div><div class="Tile_Subtitle">Ver entrenadores</div></div>'
                    WebRegisterPath ntNavigateForwardCustom oSelectEntrenador
                    Procedure OnClick String sId String sParam
                        Send NavigatePath
                    End_Procedure
                End_Object

                Object oJugadorTile is a cWebHtmlBox
                    Set pbServerOnClick to True
                    Set piColumnSpan to 4
                    Set piColumnIndex to 6
                    Set psCSSClass to "Tile Dark"
                    Set psHtml to '<div class="TileInner" data-ServerOnClick="openview"><div class="Tile_Title">⚽ Jugadores</div><div class="Tile_Subtitle">Ver jugadores</div></div>'
                    WebRegisterPath ntNavigateForwardCustom oSelectJugador
                    Procedure OnClick String sId String sParam
                        Send NavigatePath
                    End_Procedure
                End_Object
            End_Object

            Object oFilaInferior is a cWebGroup
                Set piColumnSpan to 12
                Set piColumnCount to 12
                Set pbShowBorder to False
                Set pbShowCaption to False
        
                Object oPosicionTile is a cWebHtmlBox
                    Set pbServerOnClick to True
                    Set piColumnSpan to 4
                    Set piColumnIndex to 0
                    Set psCSSClass to "Tile DarkAlternate"
                    Set psHtml to '<div class="TileInner" data-ServerOnClick="openview"><div class="Tile_Title">📍 Posiciones</div><div class="Tile_Subtitle">Ver posiciones</div></div>'
                    WebRegisterPath ntNavigateForwardCustom oSelectPosicion
                    Procedure OnClick String sId String sParam
                        Send NavigatePath
                    End_Procedure
                End_Object
        
                Object oEquipoTile is a cWebHtmlBox
                    Set pbServerOnClick to True
                    Set piColumnSpan to 4
                    Set piColumnIndex to 4
                    Set psCSSClass to "Tile Light"
                    Set psHtml to '<div class="TileInner" data-ServerOnClick="openview"><div class="Tile_Title">🛡 Equipos</div><div class="Tile_Subtitle">Ver equipos</div></div>'
                    WebRegisterPath ntNavigateForwardCustom oSelectEquipo
                    Procedure OnClick String sId String sParam
                        Send NavigatePath
                    End_Procedure
                End_Object
        
                Object oLigaTile is a cWebHtmlBox
                    Set pbServerOnClick to True
                    Set piColumnSpan to 4
                    Set piColumnIndex to 5
                    Set psCSSClass to "Tile LightAlternate"
                    Set psHtml to '<div class="TileInner" data-ServerOnClick="openview"><div class="Tile_Title">🏆 Ligas</div><div class="Tile_Subtitle">Ver ligas</div></div>'
                    WebRegisterPath ntNavigateForwardCustom oSelectLiga
                    Procedure OnClick String sId String sParam
                        Send NavigatePath
                    End_Procedure
                End_Object
            End_Object

        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
        // Each time this view is shown we will update the appropriate information.
    End_Procedure

End_Object